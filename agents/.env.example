# OpenRouter API key used by the Clarus coded agents.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the model (defaults to a free Gemma model on OpenRouter).
# Any OpenRouter model id works, e.g. anthropic/claude-3.5-sonnet
# CLARUS_MODEL=google/gemma-4-26b-a4b-it:free

# Optional: shown on your OpenRouter dashboard for attribution.
# CLARUS_SITE_URL=https://clarus.local
